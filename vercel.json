{
  "version": 2,
  "builds": [
    {
      "src": "index.tsx",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "index.tsx"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "index.tsx"
    }
  ]
}